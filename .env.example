# Discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ALLOWLIST=
DISCORD_CHANNEL_DENYLIST=
DISCORD_INITIAL_BACKFILL_LIMIT=500

# Slack
SLACK_BOT_TOKEN=
SLACK_TARGET_CHANNEL=
SLACK_POST_ENABLED=true

# LLM
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_ENABLED=true
LLM_MAX_OUTPUT_TOKENS=2000

# Scheduling
TIMEZONE=America/Los_Angeles
DIGEST_CRON=0 5 * * *
DIGEST_RUN_ON_START=true
DIGEST_WINDOW_HOURS=24

# Database
DATABASE_PATH=data/app.db

# Logging
LOG_LEVEL=INFO
